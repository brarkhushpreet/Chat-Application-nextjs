# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus_chat"

# Auth.js authentication
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Leave AUTH_URL unset in development so Auth.js accepts localhost and LAN hosts.
# Set it to the single public HTTPS URL in production.
# AUTH_URL="https://chat.example.com"

# Uploaded files use local .local/uploads in Node development and R2 on Workers.

# Realtime server
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT="3000"
APP_HOSTNAME="0.0.0.0"

# Optional direct Neon URL for Prisma schema commands (not needed by Workers).
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Cloudflare TURN: server-only keys, required for deployed cross-network calls.
TURN_KEY_ID=""
TURN_API_TOKEN=""
